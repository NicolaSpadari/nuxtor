{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "desktop",
	"description": "Desktop-only capabilities",
	"platforms": [
		"linux",
		"macOS",
		"windows"
	],
	"windows": [
		"main",
		"secondary"
	],
	"permissions": [
		"core:tray:default",
		"core:menu:default",
		{
			"identifier": "shell:allow-execute",
			"allow": [
				{
					"name": "exec-sh",
					"cmd": "sh",
					"args": [
						"-c",
						{
							"validator": "\\S.*"
						}
					]
				}
			]
		}
	]
}
