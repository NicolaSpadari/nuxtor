{
	// Same behaviour as .vscode/settings.json: no formatter, ESLint --fix on save.
	// ESLint is attached by default only to JavaScript, TypeScript, TSX and Vue.js:
	// the other languages enable it through "language_servers".
	"hard_tabs": true,
	"tab_size": 4,

	// Tailwind CSS language server settings
	"lsp": {
		"tailwindcss-language-server": {
			"settings": {
				"experimental": {
					"classRegex": [
						["ui:\\s*{([^)]*)\\s*}", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
					]
				},
				"classAttributes": ["class", "ui"]
			}
		}
	},

	"languages": {
		"CSS": {
			"language_servers": ["tailwindcss-language-server", "!vscode-css-language-server"]
		},
		"JavaScript": {
			"format_on_save": "on",
			"formatter": [{ "code_action": "source.fixAll.eslint" }]
		},
		"TypeScript": {
			"format_on_save": "on",
			"formatter": [{ "code_action": "source.fixAll.eslint" }]
		},
		"TSX": {
			"format_on_save": "on",
			"formatter": [{ "code_action": "source.fixAll.eslint" }]
		},
		"Vue.js": {
			"format_on_save": "on",
			"formatter": [{ "code_action": "source.fixAll.eslint" }]
		},
		"HTML": {
			"format_on_save": "on",
			"formatter": [{ "code_action": "source.fixAll.eslint" }],
			"language_servers": ["eslint", "..."]
		},
		"Markdown": {
			"format_on_save": "on",
			"formatter": [{ "code_action": "source.fixAll.eslint" }],
			"language_servers": ["eslint", "..."]
		},
		"JSON": {
			"format_on_save": "on",
			"formatter": [{ "code_action": "source.fixAll.eslint" }],
			"language_servers": ["eslint", "..."]
		},
		"JSONC": {
			"format_on_save": "on",
			"formatter": [{ "code_action": "source.fixAll.eslint" }],
			"language_servers": ["eslint", "..."]
		},
		"YAML": {
			"hard_tabs": false,
			"tab_size": 2,
			"format_on_save": "on",
			"formatter": [{ "code_action": "source.fixAll.eslint" }],
			"language_servers": ["eslint", "..."]
		},
		"TOML": {
			"format_on_save": "on",
			"formatter": [{ "code_action": "source.fixAll.eslint" }],
			"language_servers": ["eslint", "..."]
		}
	}
}
